{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "data": {
    "url": "../data/tra_seasonal_activity_2024.csv"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 65
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "quarter",
      "type": "nominal",
      "title": "2024 quarter",
      "sort": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ]
    },
    "y": {
      "field": "annual_share_pct",
      "type": "quantitative",
      "title": "Share of activity annual trips (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "activity",
      "type": "nominal",
      "scale": {
        "domain": [
          "Beach",
          "National parks",
          "Bushwalking",
          "Fishing",
          "Surfing",
          "Snow skiing"
        ],
        "range": [
          "#137b8b",
          "#547a4a",
          "#93a755",
          "#d9a25e",
          "#4c9fc5",
          "#8476a6"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 3
      }
    },
    "tooltip": [
      {
        "field": "activity",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "quarter",
        "type": "nominal",
        "title": "Quarter"
      },
      {
        "field": "annual_share_pct",
        "type": "quantitative",
        "title": "Annual share (%)",
        "format": ".1f"
      }
    ]
  },
  "width": "container",
  "height": 300,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#52646b",
      "titleColor": "#52646b",
      "gridColor": "#e6eeec"
    },
    "legend": {
      "labelColor": "#52646b",
      "titleColor": "#52646b"
    }
  }
}