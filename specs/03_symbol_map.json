{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#546378",
      "titleColor": "#34445a",
      "domain": false,
      "tickColor": "#d5dde4",
      "gridColor": "#e7edf1",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#546378",
      "titleColor": "#34445a",
      "labelFontSize": 11
    },
    "header": {
      "labelColor": "#34445a",
      "titleColor": "#34445a"
    }
  },
  "width": 710,
  "height": 600,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 820,
    "translate": [
      355,
      295
    ]
  },
  "params": [
    {
      "name": "activityPick",
      "value": "Snow skiing",
      "bind": {
        "input": "select",
        "options": [
          "Snow skiing",
          "Beach",
          "Bushwalking",
          "National parks",
          "Fishing",
          "Surfing"
        ],
        "labels": [
          "Snow skiing",
          "Go to the beach",
          "Bushwalking",
          "National parks",
          "Fishing",
          "Surfing"
        ],
        "name": "Activity shown: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "../data/regions.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8f0ee",
        "stroke": "#b4c5c3",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "../data/region_centroids.csv"
      },
      "transform": [
        {
          "filter": "datum.activity === activityPick"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#df6d4b",
        "stroke": "#ffffff",
        "strokeWidth": 0.8,
        "opacity": 0.77
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "trips_000",
          "type": "quantitative",
          "title": "Trips (000)",
          "scale": {
            "type": "sqrt",
            "range": [
              16,
              2200
            ]
          }
        },
        "tooltip": [
          {
            "field": "region",
            "title": "Region"
          },
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "trips_000",
            "title": "Trips (000)",
            "format": ",.1f"
          }
        ]
      }
    }
  ]
}
