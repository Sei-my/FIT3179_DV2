  "params": [
    {
      "name": "metricPick",
      "value": "Temperature (°C)",
      "bind": {
        "input": "select",
        "options": [
          "Temperature (°C)",
          "Rainfall (mm)"
        ],
        "labels": [
          "Temperature · °C",
          "Rainfall · mm"
        ],
        "name": "Climate measure: "
      }
    }
  ],
  "transform": [
    {
      "calculate": "metricPick === 'Temperature (°C)' ? toNumber(datum.temp_c) : toNumber(datum.rain_mm)",
      "as": "metric_value"
    },
    {
      "calculate": "metricPick === 'Temperature (°C)' ? '°C' : 'mm'",
      "as": "metric_unit"
    },
    {
      "calculate": "metricPick === 'Temperature (°C)' ? datum.metric_value / 32 : datum.metric_value / 700",
      "as": "metric_normalized"
    }
  ],
